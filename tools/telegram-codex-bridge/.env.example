# Copy this file to .env and fill values locally.
# Do not paste the bot token into chat.
TELEGRAM_BOT_TOKEN=PASTE_NEW_REVOKED_TOKEN_HERE

# Leave empty if you want to claim the bridge from Telegram with /claim <code>.
# After a successful claim, the chat id is stored in state.json.
TELEGRAM_ALLOWED_CHAT_ID=
CLAIM_CODE=change-this-long-random-code

WORKSPACE_ROOT=D:\Đồ án tốt nghiệp
ALLOWED_REPOS=.,project,NLP model,academic-research-skills,research_callcenteren_baseline

# Use codex if Codex CLI standalone is in PATH.
CODEX_COMMAND=codex
CODEX_EXTRA_ARGS=--dangerously-bypass-approvals-and-sandbox --model gpt-5.5
CODEX_PROMPT_SUFFIX=Output rule: Tra loi cuoi cung bang tieng Viet, ngan gon va dung trong tam. Khong trinh bay suy nghi noi bo hoac chain-of-thought. Khong giai thich dai dong neu khong duoc yeu cau ro. Gioi han toi da 500 tu.
SEND_PROGRESS_CHUNKS=false
OUTPUT_MAX_WORDS=500
CODEX_TIMEOUT_SECONDS=1800
TELEGRAM_POLL_TIMEOUT_SECONDS=50

